# Voice Shield AI Backend Configuration
VOICE_SHIELD_APP_NAME="VOICE SHIELD AI"

# CORS & Frontend Origins (e.g. your Vercel deployment URL)
VOICE_SHIELD_FRONTEND_URL=https://your-frontend-app.vercel.app
VOICE_SHIELD_ALLOWED_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Optional: Deepfake detection model (Leave blank for fast, CPU-native acoustic baseline)
# VOICE_SHIELD_DEEPFAKE_MODEL_ID=MelodyMachine/Deepfake-audio-detection

# Risk Scoring Weights (Defaults: 0.45 deepfake, 0.15 prosody, 0.20 speaker, 0.20 context)
VOICE_SHIELD_DEEPFAKE_WEIGHT=0.45
VOICE_SHIELD_PROSODY_WEIGHT=0.15
VOICE_SHIELD_SPEAKER_WEIGHT=0.20
VOICE_SHIELD_CONTEXT_WEIGHT=0.20

