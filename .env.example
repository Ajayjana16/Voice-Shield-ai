# ===================================================
# VOICE SHIELD AI — ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================

# ---------------------------------------------------
# FRONTEND CONFIGURATION (Vercel)
# ---------------------------------------------------
# Set this in Vercel Project Settings -> Environment Variables
VITE_API_BASE_URL=https://your-backend-service.onrender.com/api

# ---------------------------------------------------
# BACKEND CONFIGURATION (Render / Railway / Cloud)
# ---------------------------------------------------
# Set these in your backend hosting provider's Environment Variables
VOICE_SHIELD_APP_NAME="VOICE SHIELD AI"
VOICE_SHIELD_FRONTEND_URL=https://your-frontend-app.vercel.app
VOICE_SHIELD_ALLOWED_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Optional: Pretrained neural anti-spoofing model (Default uses fast CPU-native acoustic baseline)
# VOICE_SHIELD_DEEPFAKE_MODEL_ID=MelodyMachine/Deepfake-audio-detection
